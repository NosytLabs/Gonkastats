    },
    {
      "id": "97",
      "title": "Increase DeepSeek V4 Flash weight_scale_factor to 0.246",
      "summary": "Increase the weight_scale_factor for deepseek-ai/DeepSeek-V4-Flash-0731 from 0.214 to 0.246. All other model and chain parameters remain unchanged.\n\nThe original factor came from inflated nonce/min numbers. The measurement fix and reproduction steps are in gonka-ai/gonka#1640 (open, will be proposed with the next mainnet update).\n\nRecomputed on historical B300 nonce data and fresh PoC experiments, the factor is 0.246.",
      "status": "REJECTED",
      "votingStart": "2026-08-25T03:47:31.768213501Z",
